# Local development defaults
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# Browser-visible URLs
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Summon integration defaults
SUMMON_ENDPOINT=/api/summon
SUMMON_HEALTH_ENDPOINT=/health
SUMMON_SOURCE=local
SUMMON_MESSAGE=Open the personal agent dashboard.

# Real tool bridge
COMPOSIO_ENABLED=1
COMPOSIO_CLI_PATH=~/.composio/composio
COMPOSIO_TIMEOUT_SECONDS=30
